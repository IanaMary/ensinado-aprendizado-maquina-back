MONGO_URL=mongodb://localhost:27017
MONGO_DB=ensinado_aprendizado_maquina
SECRET_KEY=CHANGE_ME
TOKEN_EXPIRE_MINUTES=240   # 4 h; ver o comentário em app/routers/login.py
ALLOWED_ORIGINS=http://localhost:4200,https://absapt.tk

# Configuração de Email (SMTP)
# Para envio de convites e notificações
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
EMAIL_FROM=noreply@h2ia.ufpel.edu.br
FRONTEND_URL=https://absapt.tk/h2ia/tutor

# Provedor de LLM do tutor. A NVIDIA é o padrão; OpenRouter e endpoints customizados
# (OpenAI-compatible) são configurados pelo admin em conf-tutor → Provedores, e a chave deles
# fica no banco. Só declare aqui a chave que você prefere manter fora do banco.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
OPENROUTER_API_KEY=
ORCAROUTER_API_KEY=
# Google AI Studio pela camada de compatibilidade OpenAI (a chave sai de
# https://aistudio.google.com/app/api-keys). O nível gratuito cobre a linha Flash.
GEMINI_API_KEY=

# Tetos do chat do tutor (opcionais; os defaults estão no código).
# Caracteres do contexto do pipeline; tokens da resposta por nível do aluno.
CHAT_MAX_CONTEXTO_CHARS=12000
CHAT_MAX_TOKENS=1536
CHAT_MAX_TOKENS_AVANCADO=3072
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW=60

# Segundos que o /healthcheck espera o MongoDB antes de responder 503.
HEALTHCHECK_TIMEOUT=3

# Retenção da telemetria de atividades, em dias (0 desativa o TTL).
ATIVIDADE_TTL_DIAS=90

# MLflow (opcional). Sem MLFLOW_TRACKING_URI o registro de runs vira no-op.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=h2ia-treinamento
